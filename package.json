{
  "name": "dsh-tiktok-topic",
  "version": "0.1.0",
  "description": "TikTok 话题雷达 · 按 TikTok 话题 ID（challengeId/hashtagId）查询话题下作品列表：播放/点赞/评论/分享核心数据 + 完整作品链接，支持排序切换与游标翻页，侧栏看板。需 RedFox API Key，移植自 redfox-data/redfox-community skills/tiktok-topic-aweme-list。",
  "license": "MIT",
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "src",
    "dist",
    "lib",
    "lab",
    "skills",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "tiktok",
    "hashtag",
    "challenge",
    "topic",
    "analytics"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "live": "node scripts/live.mjs",
    "dev": "node scripts/devserver.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  }
}
